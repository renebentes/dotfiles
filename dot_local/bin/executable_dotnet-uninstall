#!/usr/bin/env bash
# Simple command line interface for uninstalling .NET components from a specified location.

set -euo pipefail

INSTALL_DIR="<auto>"
VERBOSE=false
DRY_RUN=false
INVENTORY_FILE=""
SELECTED_COMPONENTS=()
REMOVAL_PLAN=""

# Use in the the functions: eval $invocation
# shellcheck disable=SC2016
invocation='say_verbose "Calling: ${yellow:-}${FUNCNAME[0]} ${green:-}$*${normal:-}"'

# standard output may be used as a return value in the functions
# we need a way to write text on the screen in the functions so that
# it won't interfere with the return value.
# Exposing stream 3 as a pipe to standard output of the script itself
exec 3>&1

# Setup some colors to use. These need to work in fairly limited shells, like the Ubuntu Docker container where there are only 8 colors.
# See if stdout is a terminal
if [ -t 1 ] && command -v tput >/dev/null; then
    # see if it supports colors
    ncolors=$(tput colors || echo 0)
    if [ -n "$ncolors" ] && [ "$ncolors" -ge 8 ]; then
        bold="$(tput bold || echo)"
        normal="$(tput sgr0 || echo)"
        black="$(tput setaf 0 || echo)"
        red="$(tput setaf 1 || echo)"
        green="$(tput setaf 2 || echo)"
        yellow="$(tput setaf 3 || echo)"
        blue="$(tput setaf 4 || echo)"
        magenta="$(tput setaf 5 || echo)"
        cyan="$(tput setaf 6 || echo)"
        white="$(tput setaf 7 || echo)"
    fi
fi

say_warning() {
    printf "%b\n" "${yellow:-}dotnet_uninstall: Warning: $1${normal:-}" >&3
}

say_err() {
    printf "%b\n" "${red:-}dotnet_uninstall: Error: $1${normal:-}" >&2
}

say() {
    # using stream 3 (defined in the beginning) to not interfere with stdout of functions
    # which may be used as return value
    printf "%b\n" "${cyan:-}dotnet-uninstall:${normal:-} $1" >&3
}

say_verbose() {
    if [ "${VERBOSE}" = true ]; then
        say "$1"
    fi
}

get_user_install_path() {
    eval "$invocation"

    if [[ -n "${DOTNET_INSTALL_DIR:-}" ]]; then
        echo "$DOTNET_INSTALL_DIR"
    else
        echo "$HOME/.dotnet"
    fi
    return 0
}

resolve_installation_path() {
    eval "$invocation"

    local install_dir=$1
    if [[ "$install_dir" = "<auto>" ]]; then
        local user_install_path
        user_install_path="$(get_user_install_path)"
        say_verbose "resolve_installation_path: user_install_path=$user_install_path"
        echo "$user_install_path"
        return 0
    fi

    echo "$install_dir"
    return 0
}

usage() {
    cat <<<".NET Uninstaller
Usage: dotnet-uninstall [-i|--install-dir DIR] [-n|--dry-run] [-v|--verbose] [-h|--help]

dotnet-uninstall lists .NET components under the selected installation root.
    It is intended for installations created with dotnet-install.sh.
    The source of individual components cannot be detected. Review the selected
    installation root carefully; removing shared components may affect other SDKs.

Options:
  -i, --install-dir <DIR>    The location to uninstall from (see Install Location below)
  -n, --dry-run              Do not remove anything. Display the removal plan.
  -v, --verbose              Verbose output
  -h, --help                 Shows this help message

Install Location:
  Location is chosen in following order:
    - --install-dir option
    - Environmental variable DOTNET_INSTALL_DIR
    - $HOME/.dotnet
"
}

check_dependencies() {
    eval "$invocation"

    if ! command -v fzf >/dev/null 2>&1; then
        say_err "fzf is required but was not found."
        exit 1
    fi
}

create_inventory() {
    eval "$invocation"

    INVENTORY_FILE="$(mktemp)"
    trap 'rm -f "$INVENTORY_FILE"' EXIT

    say_verbose "create_inventory: INVENTORY_FILE=$INVENTORY_FILE"

    printf '%s\t%s\t%s\t%s\t%s\n' \
        "type" "name" "version" "path" "metadata" \
        >"$INVENTORY_FILE"
}

inventory_add() {
    eval "$invocation"

    local type=$1
    local name=$2
    local version=$3
    local path=$4
    local metadata=${5:-}

    say_verbose "inventory_add: type=$type, name=$name, version=$version, path=$path, metadata=$metadata"

    printf '%s\t%s\t%s\t%s\t%s\n' \
        "$type" "$name" "$version" "$path" "$metadata" \
        >>"$INVENTORY_FILE"
}

inventory_version_directories() {
    eval "$invocation"

    local type=$1
    local name=$2
    local parent=$3
    local component_path version

    [[ -d "$parent" && ! -L "$parent" ]] || return 0

    for component_path in "$parent"/*; do
        [[ -d "$component_path" && ! -L "$component_path" ]] || continue
        version="${component_path##*/}"

        if [[ ! "$version" =~ ^[0-9][A-Za-z0-9.+-]*$ ]]; then
            say_warning "Ignoring unrecognized component directory: '$component_path'"
            continue
        fi

        inventory_add "$type" "$name" "$version" "$component_path"
    done
}

inventory_components() {
    eval "$invocation"

    local root component_path feature_band manifest_name manifest_path manifest_version

    inventory_version_directories "sdk" "SDK" "$INSTALL_DIR/sdk"
    inventory_version_directories "runtime" "Microsoft.NETCore.App" "$INSTALL_DIR/shared/Microsoft.NETCore.App"
    inventory_version_directories "runtime" "Microsoft.AspNetCore.App" "$INSTALL_DIR/shared/Microsoft.AspNetCore.App"

    root="$INSTALL_DIR/shared"
    if [[ -d "$root" && ! -L "$root" ]]; then
        for component_path in "$root"/*; do
            [[ -d "$component_path" && ! -L "$component_path" ]] || continue
            case "${component_path##*/}" in
            Microsoft.NETCore.App | Microsoft.AspNetCore.App) continue ;;
            esac
            inventory_version_directories "runtime" "${component_path##*/}" "$component_path"
        done
    fi

    inventory_version_directories "hostfxr" "host/fxr" "$INSTALL_DIR/host/fxr"

    root="$INSTALL_DIR/packs"
    if [[ -d "$root" && ! -L "$root" ]]; then
        for component_path in "$root"/*; do
            [[ -d "$component_path" && ! -L "$component_path" ]] || continue
            inventory_version_directories "pack" "${component_path##*/}" "$component_path"
        done
    fi

    root="$INSTALL_DIR/sdk-manifests"
    if [[ -d "$root" && ! -L "$root" ]]; then
        for feature_band in "$root"/*; do
            [[ -d "$feature_band" && ! -L "$feature_band" ]] || continue
            for manifest_path in "$feature_band"/*; do
                [[ -d "$manifest_path" && ! -L "$manifest_path" ]] || continue
                manifest_name="${manifest_path##*/}"
                for component_path in "$manifest_path"/*; do
                    [[ -d "$component_path" && ! -L "$component_path" ]] || continue
                    manifest_version="${component_path##*/}"
                    if [[ ! "$manifest_version" =~ ^[0-9][A-Za-z0-9.+-]*$ ]]; then
                        say_warning "Ignoring unrecognized component directory: '$component_path'"
                        continue
                    fi
                    inventory_add "manifest" "$manifest_name" "$manifest_version" "$component_path" "${feature_band##*/}"
                done
            done
        done
    fi

    inventory_version_directories "template" "templates" "$INSTALL_DIR/templates"
}

inventory() {
    eval "$invocation"

    say_verbose "Inventorying .NET installation: '$INSTALL_DIR'"

    create_inventory
    inventory_components
}

run_component_selector() {
    eval "$invocation"

    local fzf_options=(
        --ansi
        --border
        --header "TAB selects components; ENTER confirms. Components may be shared."
        --height=80%
        --multi
        --prompt="Select components to remove: "
        --layout=reverse
        --with-nth="1,2,3,4"
    )

    tail -n +2 "$INVENTORY_FILE" | fzf "${fzf_options[@]}"
}

inventory_has_components() {
    eval "$invocation"

    [[ "$(awk 'END { print NR - 1 }' "$INVENTORY_FILE")" -gt 0 ]]
}

select_components() {
    eval "$invocation"

    local selected_lines type name version path metadata

    if selected_lines="$(run_component_selector)"; then
        :
    else
        fzf_status=$?

        case "$fzf_status" in
        130)
            say "Component selection cancelled."
            return 1
            ;;
        *)
            say_err "fzf failed with exit code $fzf_status."
            return 1
            ;;
        esac
    fi

    SELECTED_COMPONENTS=()

    while IFS=$'\t' read -r type name version path metadata; do
        [[ -n "$path" ]] || continue
        SELECTED_COMPONENTS+=("$path")
    done <<<"$selected_lines"

    say_verbose "Selected components: ${#SELECTED_COMPONENTS[@]}"
}

build_removal_plan() {
    eval "$invocation"

    local selected_path type name version path metadata found
    for selected_path in "${SELECTED_COMPONENTS[@]}"; do
        found=false

        while IFS=$'\t' read -r type name version path metadata; do
            if [[ "$path" == "$selected_path" ]]; then
                found=true
                break
            fi
        done < <(tail -n +2 "$INVENTORY_FILE")

        if [[ "$found" != true ]]; then
            say_err "Selected component was not found in the inventory: '$selected_path'"
            return 1
        fi

        printf '%s\t%s\t%s\t%s\t%s\n' \
            "$type" \
            "$name" \
            "$version" \
            "$path" \
            "$metadata"

        say_verbose "build_removal_plan: type=$type, name=$name, version=$version, path=$path, metadata=$metadata"
    done
}

display_removal_plan() {
    eval "$invocation"

    say "Removal plan:"

    printf '\n'

    if [[ -z "$REMOVAL_PLAN" ]]; then
        say "Nothing to remove."
        return 0
    fi

    awk -F '\t' '{ printf "%-10s %-32s %-18s %s\n", $1, $2, $3, $4 }' <<<"$REMOVAL_PLAN"

    printf '\n'
}

remove_selected_components() {
    eval "$invocation"

    local type name version path metadata expected_parent resolved_path
    while IFS=$'\t' read -r type name version path metadata; do
        [[ -n "$path" ]] || continue

        if [[ ! "$version" =~ ^[0-9][A-Za-z0-9.+-]*$ ||
            "${path##*/}" != "$version" ||
            ! -d "$path" ||
            -L "$path" ]]; then
            say_err "Refusing to remove an unexpected component path: '$path'"
            return 1
        fi

        case "$type" in
        sdk)
            expected_parent="$INSTALL_DIR/sdk"
            [[ "$name" == "SDK" ]] || expected_parent=""
            ;;
        runtime)
            expected_parent="$INSTALL_DIR/shared/$name"
            ;;
        hostfxr)
            expected_parent="$INSTALL_DIR/host/fxr"
            [[ "$name" == "host/fxr" ]] || expected_parent=""
            ;;
        pack)
            expected_parent="$INSTALL_DIR/packs/$name"
            ;;
        manifest)
            expected_parent="$INSTALL_DIR/sdk-manifests/$metadata/$name"
            ;;
        template)
            expected_parent="$INSTALL_DIR/templates"
            [[ "$name" == "templates" ]] || expected_parent=""
            ;;
        *)
            expected_parent=""
            ;;
        esac

        if [[ -z "$expected_parent" ||
            "${path%/*}" != "$expected_parent" ||
            ! -d "$expected_parent" ||
            -L "$expected_parent" ]]; then
            say_err "Refusing to remove a component outside the expected installation layout: '$path'"
            return 1
        fi

        resolved_path="$(cd -- "$path" && pwd -P)"
        if [[ "$resolved_path" != "$path" ]]; then
            say_err "Refusing to remove a component reached through a symbolic link: '$path'"
            return 1
        fi

        say "Removing $type $name $version from '$path'."
        if ! rm -rf -- "$path"; then
            say_err "Failed to remove component '$path'."
            return 1
        fi
    done <<<"$REMOVAL_PLAN"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
    -i | --install-dir)
        if [[ $# -lt 2 ]]; then
            say_err "'$1' option must require an argument."
            exit 1
        fi
        shift
        INSTALL_DIR="$1"
        ;;
    -h | --help)
        usage
        exit 0
        ;;
    -n | --dry-run)
        DRY_RUN=true
        ;;
    -v | --verbose)
        VERBOSE=true
        ;;
    *)
        say_err "Unknown argument \`$1\`"
        exit 1
        ;;
    esac
    shift
done

say_verbose "Note that this script is intended only for manual .NET installation scenarios."
say_verbose "Please, prefer using installers in development environment."

check_dependencies

INSTALL_DIR="$(resolve_installation_path "$INSTALL_DIR")"
say_verbose ".NET installation root: '$INSTALL_DIR'"

if [[ ! -d "$INSTALL_DIR" ]]; then
    say_warning "Installation directory does not exist: '$INSTALL_DIR'"
    exit 0
fi

INSTALL_DIR="$(cd -- "$INSTALL_DIR" && pwd -P)"
say_verbose "Resolved .NET installation root: '$INSTALL_DIR'"

inventory

if ! inventory_has_components; then
    say "No removable .NET components found in '$INSTALL_DIR'."
    exit 0
fi

say_warning "Components can be shared by multiple SDKs or runtimes. Review the removal plan carefully."

if ! select_components; then
    say "No components selected for removal. Exiting."
    exit 0
fi

if [[ "${#SELECTED_COMPONENTS[@]}" -eq 0 ]]; then
    say "No components selected for removal. Exiting."
    exit 0
fi

REMOVAL_PLAN="$(build_removal_plan)"
say_verbose "Removal plan:\n$REMOVAL_PLAN"
display_removal_plan

if [[ "${DRY_RUN}" = true ]]; then
    say "Dry-run completed. No changes were made."
    exit 0
fi

if ! read -r -p "Remove the components listed above? [y/N] " answer; then
    say "Removal cancelled."
    exit 0
fi

if [[ ! "$answer" =~ ^[Yy]([Ee][Ss])?$ ]]; then
    say "Removal cancelled."
    exit 0
fi

remove_selected_components

say "Uninstallation finished successfully"
