{{ if (eq .chezmoi.os "linux") -}}
#!/usr/bin/env bash
# ~/.local/share/chezmoi/run_after_install-binary-external-packages.bash
# ============================================================================
# Runs after `chezmoi apply` to download external binary packages via curl and
# install on Linux.
#
# Be careful! Random links can be risky. Use only verified links.
#
# Chezmoi will skip this script on other operating systems.
#
# See https://www.chezmoi.io/user-guide/use-scripts-to-perform-actions/

{{ range .packages.linux.external -}}
curl -fsSL {{ . }} | bash
{{ end -}}

{{- else }}
:
{{- end }}
