{{ if eq .chezmoi.os "windows" -}}
# ~/.local/share/chezmoi/run_apply-profile-powershell.ps1
# ============================================================================
# Runs when you execute `chezmoi apply` to apply profile to Microsoft PowerShell.
#
# Chezmoi will skip this script on other operating systems.
#
# See https://www.chezmoi.io/user-guide/use-scripts-to-perform-actions/

$SourceFile = "$env:USERPROFILE\.config\powershell\Microsoft.PowerShell_profile.ps1"
$DestinationFile = "$PROFILE"

Copy-Item $SourceFile $DestinationFile

{{- end }}
