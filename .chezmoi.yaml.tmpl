# ~/.local/share/chezmoi/.chezmoi.yaml.tmpl
# =============================================================================
# Used to customize configuration when doing a `chezmoi init`.
#
# This template file will trigger prompts to fill-in machine-specific
# templateable values. The resulting file is then created at
# `~/.config/chezmoi/chezmoi.yaml`
# See https://www.chezmoi.io/docs/how-to/

{{- $email := promptStringOnce . "email" "Your email address" -}}
{{- $key := promptStringOnce . "key" "Your GPG key" -}}
{{- $isWindows := (eq .chezmoi.os "windows") -}}
{{- $isLinux := (eq .chezmoi.os "linux") -}}
{{- $isWsl := (and (eq .chezmoi.os "linux") (.chezmoi.kernel.osrelease | contains "[Mm]icrosoft")) }}

{{ if $isWindows -}}
cd:
  command: "pwsh"
  args: ["-NoLogo", "-NoExit", "-Command", "& {Set-Location $env:HOMEPATH/.local/share/chezmoi}"]
{{ end -}}

data:
  email: {{ $email | quote }}
  key: {{ $key | quote }}
  isWindows: {{ $isWindows }}
  isLinux: {{ $isLinux }}
  isWsl: {{ $isWsl }}
